# Copy to .env (or set these in your hosting dashboard). Never commit real values.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Email notifications for new contact messages (Gmail needs an App Password)
EMAIL_HOST_USER=rajibsunar888@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
CONTACT_NOTIFY_EMAIL=rajibsunar888@gmail.com

# Optional free CAPTCHA: https://dash.cloudflare.com -> Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional PostgreSQL (otherwise SQLite is used)
# DB_ENGINE=postgres
# DB_NAME=portfolio
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
